<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for this repository.

  Without this file a restore falls back to whatever sources the machine
  happens to have configured. That works on a developer box but not on a
  build agent, where the restore task resolves nothing and every package
  fails with NU1100. Clearing first means the build uses exactly these
  sources wherever it runs.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
