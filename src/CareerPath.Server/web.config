<?xml version="1.0" encoding="utf-8"?>
<!--
  Source-controlled web.config. The .NET SDK's _TransformWebConfig target
  preserves attributes/children we set here (stdoutLogEnabled, environment
  variables) while still rewriting processPath/arguments at publish time.

  Stdout logging is intentionally on so we can diagnose IIS startup errors
  (e.g. EnsureCreated() failing because App_Data isn't writable). Logs land
  in .\logs\stdout_*.log next to the binary; the AppPool identity needs
  Modify rights on that folder for them to actually appear.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\CareerPath.Server.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
