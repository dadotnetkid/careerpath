<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <MudText Typo="Typo.h5" Class="mt-8 mx-auto" Align="Align.Center">Page not found</MudText>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#007F3B",
            Secondary = "#FFD701",
            AppbarBackground = "#007F3B",
            AppbarText = "#FFFFFF",
            Background = "#f5f6f0",
            Surface = "#FFFFFF",
            TextPrimary = "#1a2e1a",
            TextSecondary = "#5a6b5a",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#1a2e1a",
            DrawerIcon = "#007F3B"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Inter", "Roboto", "Helvetica", "Arial", "sans-serif" }
            },
            H1 = new H1Typography() { FontFamily = new[] { "Source Serif 4", "Georgia", "serif" } },
            H2 = new H2Typography() { FontFamily = new[] { "Source Serif 4", "Georgia", "serif" } },
            H3 = new H3Typography() { FontFamily = new[] { "Source Serif 4", "Georgia", "serif" } },
            H4 = new H4Typography() { FontFamily = new[] { "Source Serif 4", "Georgia", "serif" } },
            H5 = new H5Typography() { FontFamily = new[] { "Source Serif 4", "Georgia", "serif" } },
            H6 = new H6Typography() { FontFamily = new[] { "Source Serif 4", "Georgia", "serif" } }
        }
    };
}
