@page "/riasec"
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject CareerPath.Client.Services.AuthService Auth
@implements IDisposable

<PageTitle>Career Path Assessment</PageTitle>

<MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4" Style="font-family:'Source Serif 4',serif; border-bottom:3px solid #FFD700; padding-bottom:8px;">
    Career Path Assessment
</MudText>

@if (isLoadingQuestions)
{
    <div class="d-flex justify-center pa-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (finalResult != null)
{
    @* ══════════ STEP 6: RESULTS ══════════ *@

    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:12px;">
        <div class="d-flex justify-space-between align-center flex-wrap gap-2">
            @foreach (var (label, idx) in stepLabels.Select((l, i) => (l, i)))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" />
                    @label
                </MudChip>
            }
        </div>
    </MudPaper>

    <MudPaper Class="pa-6 mb-4" Style="background: linear-gradient(135deg, #007F3B 0%, #005a2a 100%); border-radius:12px;">
        <MudText Typo="Typo.h4" Style="color:#fff; font-family:'Source Serif 4',serif; font-weight:700;" Class="mb-2">
            Your Career Path Report
        </MudText>
        <MudText Typo="Typo.h5" Style="color:#FFD701; font-weight:700;">
            RIASEC: @finalResult.DominantCode — @string.Join(" / ", finalResult.TopDimensions)
        </MudText>
        <MudText Typo="Typo.subtitle1" Style="color:rgba(255,255,255,0.9);" Class="mt-1">
            Career Clarity: @finalResult.Clarity.TotalScore/25 — @finalResult.Clarity.ClarityLabel
        </MudText>
    </MudPaper>

    @* ══════════ Prediction lead — answer the headline question first ══════════ *@
    @if (finalResult.Prediction != null)
    {
        <MudCard Elevation="3" Class="mb-4" Style="border:2px solid #FFD700;">
            <MudCardHeader Style="background:#007F3B; color:#fff;">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Psychology" Class="mr-2" Style="vertical-align:middle;" />
                        Predicted Career Outcome
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-6">
                <div class="d-flex flex-wrap align-center gap-3 mb-4">
                    <MudChip T="string" Size="Size.Large"
                             Color="@(finalResult.Prediction.PredictedOutcome == "ICT-Aligned" ? Color.Primary : Color.Info)"
                             Variant="Variant.Filled"
                             Style="font-size:1.1rem; font-weight:700; padding:8px 20px;">
                        @finalResult.Prediction.PredictedOutcome
                    </MudChip>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary"
                                 Style="text-transform:uppercase; letter-spacing:1px;">Confidence</MudText>
                        <MudText Typo="Typo.h3" Color="Color.Primary"
                                 Style="font-family:'Source Serif 4',serif; font-weight:700; line-height:1;">
                            @((finalResult.Prediction.Confidence * 100).ToString("F0"))%
                        </MudText>
                    </div>
                </div>

                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2"
                         Style="font-weight:700;">Class Probabilities</MudText>
                @foreach (var s in finalResult.Prediction.Scores)
                {
                    <div class="d-flex align-center mb-3" style="gap:12px;">
                        <MudText Typo="Typo.body2" Style="width:160px; font-weight:500; flex-shrink:0;">@s.Label</MudText>
                        <MudProgressLinear Value="@(s.Probability * 100)" Rounded="true" Size="Size.Large"
                                           Color="@(s.Label == "ICT-Aligned" ? Color.Primary : Color.Info)"
                                           Style="flex:1; height:24px;" />
                        <MudText Typo="Typo.body2" Style="width:60px; font-weight:700; flex-shrink:0;">
                            @((s.Probability * 100).ToString("F1"))%
                        </MudText>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(finalResult.Prediction.Interpretation))
                {
                    <MudPaper Class="pa-4 mt-4" Elevation="0"
                              Style="background:#f8f9fa; border-left:4px solid #007F3B; border-radius:6px;">
                        <MudText Typo="Typo.body1" Style="line-height:1.7;">
                            @finalResult.Prediction.Interpretation
                        </MudText>
                    </MudPaper>
                }

                @if (finalResult.Prediction.SimilarAlumniJobs?.Any() == true)
                {
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mt-4 mb-2"
                             Style="font-weight:700;">
                        Alumni with similar profiles became:
                    </MudText>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var job in finalResult.Prediction.SimilarAlumniJobs)
                        {
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                                @job
                            </MudChip>
                        }
                    </div>
                }
            </MudCardContent>
        </MudCard>
    }

    @* ══════════ Save Result — students only ══════════ *@
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent Class="pa-4">
            <div class="d-flex flex-wrap align-center gap-3">
                @if (Auth.IsStudent)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@(saveSucceeded ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Save)"
                               Disabled="@(saveSucceeded || isSaving)" OnClick="SaveResult">
                        @if (isSaving)
                        {
                            <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Saving…</span>
                        }
                        else if (saveSucceeded)
                        {
                            <span>Saved</span>
                        }
                        else
                        {
                            <span>Save This Result</span>
                        }
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.BookmarkBorder" Href="my-results">
                        View My Saved Results
                    </MudButton>
                    @if (!string.IsNullOrEmpty(saveError))
                    {
                        <MudText Color="Color.Error" Typo="Typo.body2">@saveError</MudText>
                    }
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.BookmarkBorder" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @if (Auth.IsAdmin)
                        {
                            <span>Saved results are a student-only feature. Admins can browse aggregated data on the Dataset page.</span>
                        }
                        else
                        {
                            <span><strong>Want to save this result?</strong> Sign up as a CITE student to keep your assessment history.</span>
                        }
                    </MudText>
                    @if (!Auth.IsAuthenticated)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                                   OnClick="OpenRegisterFromResults">Sign Up</MudButton>
                    }
                }
            </div>
        </MudCardContent>
    </MudCard>

    <MudGrid Spacing="4" Class="mb-4">
        @* RIASEC Score Bars *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader Style="background:#007F3B; color:#fff;">
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-2" Style="vertical-align:middle;" />
                            RIASEC Dimension Scores
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-6">
                    @foreach (var dim in GetScoreList())
                    {
                        <div class="mb-4">
                            <div class="d-flex justify-space-between mb-1">
                                <MudText Typo="Typo.body1" Style="font-weight:600;">@dim.Name (@dim.Code)</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:700;">@dim.Score / @RiasecScale.MaxAreaScore</MudText>
                            </div>
                            <MudProgressLinear Value="@(dim.Score * 100.0 / RiasecScale.MaxAreaScore)" Rounded="true" Size="Size.Large" Color="@dim.Color" />
                        </div>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Career Clarity Breakdown *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Style="height:100%;">
                <MudCardHeader Style="background:#007F3B; color:#fff;">
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="mr-2" Style="vertical-align:middle;" />
                            Career Clarity Breakdown
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-6">
                    @foreach (var cr in new[] {
                        ("A. Career Fit", finalResult.Clarity.FitScore),
                        ("B. Growth Excitement", finalResult.Clarity.ExcitementScore),
                        ("C. Genuine Interest", finalResult.Clarity.GenuineInterestScore),
                        ("D. Salary-Neutral", finalResult.Clarity.SalaryNeutralScore),
                        ("E. RIASEC Alignment", finalResult.Clarity.RiasecAlignmentScore)
                    })
                    {
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudText Typo="Typo.body1">@cr.Item1</MudText>
                            <div class="d-flex align-center gap-2" style="min-width:180px;">
                                <MudProgressLinear Value="@(cr.Item2 / 5.0 * 100)" Rounded="true" Size="Size.Small" Color="Color.Primary" Style="flex:1;" />
                                <MudText Typo="Typo.body2" Style="font-weight:600; min-width:40px;">@cr.Item2/5</MudText>
                            </div>
                        </div>
                    }

                    <MudDivider Class="my-3" />
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.h6" Style="font-weight:700;">Total</MudText>
                        <MudText Typo="Typo.h6" Style="font-weight:700;" Color="Color.Primary">@finalResult.Clarity.TotalScore / 25</MudText>
                    </div>
                    <MudChip T="string" Color="@GetClarityColor(finalResult.Clarity.ClarityLabel)" Size="Size.Large" Class="mt-2">
                        @finalResult.Clarity.ClarityLabel
                    </MudChip>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* Matched Job Roles *@
    <MudCard Elevation="3" Class="mb-4">
        <MudCardHeader Style="background:#007F3B; color:#fff;">
            <CardHeaderContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.Work" Class="mr-2" Style="vertical-align:middle;" />
                    Top Matched Job Roles (from Alumni Data)
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent Class="pa-4">
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Job Title</th>
                        <th>Field</th>
                        <th>Alignment</th>
                        <th>Alumni</th>
                        <th>Match</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (job, i) in finalResult.MatchedJobs.Select((j, i) => (j, i)))
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td><strong>@job.JobTitle</strong></td>
                            <td>@job.FieldOfIndustry</td>
                            <td>@job.CareerAlignment</td>
                            <td>@job.AlumniCount</td>
                            <td>
                                <MudProgressLinear Value="@job.MatchScore" Rounded="true" Size="Size.Small" Color="Color.Primary" Style="min-width:80px;" />
                                <MudText Typo="Typo.caption">@job.MatchScore%</MudText>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudCardContent>
    </MudCard>

    @* AI Analysis — now seeded with the prediction so it agrees ══════════ *@
    <MudCard Elevation="3" Class="mb-4">
        <MudCardHeader Style="background:#007F3B; color:#fff;">
            <CardHeaderContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Class="mr-2" Style="vertical-align:middle;" />
                    Detailed AI Career Analysis (GPT-4o mini)
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent Class="pa-6">
            <MudText Typo="Typo.body1" Style="white-space:pre-line; line-height:1.8;">
                @finalResult.AiAnalysis
            </MudText>
        </MudCardContent>
    </MudCard>

    <div class="d-flex justify-center mb-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetAll">
            Retake Assessment
        </MudButton>
    </div>
}
else if (preludeStep < 2)
{
    @* ══════════ STEP 1: WELCOME (Login / Register / Guest) ══════════ *@
    @if (preludeStep == 0)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:12px;">
            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:700;">
                Step 1 of 6 — Welcome
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Sign in to save your result, sign up if you're a new CITE student, or continue as a guest.
            </MudText>
        </MudPaper>

        <MudGrid Spacing="4">
            <MudItem xs="12" md="4">
                <MudCard Elevation="3" Style="height:100%;">
                    <MudCardContent Class="text-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" Style="font-size:3rem;" />
                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">Sign Up</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 mb-3">
                            Create a CITE student account so you can save and revisit your results.
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenRegister">Sign Up</MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Elevation="3" Style="height:100%;">
                    <MudCardContent Class="text-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.Login" Color="Color.Primary" Style="font-size:3rem;" />
                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">Sign In</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 mb-3">
                            Already have an account? Sign in to continue.
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Login" OnClick="OpenLogin">Sign In</MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Elevation="3" Style="height:100%;">
                    <MudCardContent Class="text-center pa-6">
                        <MudIcon Icon="@Icons.Material.Filled.NoAccounts" Color="Color.Secondary" Style="font-size:3rem;" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-3">Continue as Guest</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 mb-3">
                            Try the assessment without an account. You'll see results, but can't save them.
                        </MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.ArrowForward" OnClick="ContinueAsGuest">
                            Continue as Guest
                        </MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    @* ══════════ STEP 2: CONSENT FORM ══════════ *@
    else if (preludeStep == 1)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:12px;">
            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:700;">
                Step 2 of 6 — Consent
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Please review the data-use notice before continuing.
            </MudText>
        </MudPaper>

        <MudCard Elevation="3" Class="mb-4">
            <MudCardHeader Style="background:#007F3B; color:#fff;">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Informed Consent</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-6">
                <MudText Typo="Typo.body1" Class="mb-3">
                    This assessment is part of a thesis project at the Nueva Vizcaya State University College of
                    Information Technology Education (CITE). By proceeding, you understand that:
                </MudText>
                <ul style="line-height:1.8;">
                    <li>Your RIASEC answers, Career Clarity ratings, academic profile (GWA, honors, competencies), and the resulting prediction are processed by the system to provide career guidance.</li>
                    <li>If you are signed in as a student, the result you choose to save is stored under your account and visible only to you. You can delete it at any time from "My Saved Results".</li>
                    <li>If you continue as a guest, nothing is persisted with your identity. Anonymous prediction logs may be kept for system diagnostics.</li>
                    <li>The system uses OpenAI's GPT-4o-mini to generate the detailed analysis; your inputs are sent to the OpenAI API for that call.</li>
                    <li>Predictions are statistical suggestions based on 301 CITE alumni records, not guarantees. Discuss your career plans with your academic adviser.</li>
                </ul>
                <MudCheckBox T="bool" @bind-Value="consentAccepted" Color="Color.Primary" Class="mt-4">
                    I have read and agree to the data-use notice above.
                </MudCheckBox>
            </MudCardContent>
        </MudCard>

        <div class="d-flex justify-space-between mb-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => preludeStep = 0)" Disabled="@Auth.IsAuthenticated">
                Back
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="StartQuiz" Disabled="@(!consentAccepted)">
                Accept and Begin Assessment
            </MudButton>
        </div>
    }
}
else
{
    @* ══════════ WIZARD STEPS 3-5 (Quiz / Clarity / Academics) ══════════ *@

    @* Step Indicator (6 chips total: Welcome ✓, Consent ✓, Quiz, Clarity, Academics, Results) *@
    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:12px;">
        <div class="d-flex justify-space-between align-center flex-wrap gap-2">
            @for (int s = 0; s < stepLabels.Length; s++)
            {
                var stepIdx = s;
                var globalIdx = stepIdx;            // 0..5
                var preludeOffset = 2;              // Welcome(0), Consent(1) before wizardStep
                var currentGlobal = preludeOffset + wizardStep;
                var isDone = globalIdx < currentGlobal;
                var isActive = globalIdx == currentGlobal;
                <MudChip T="string" Size="Size.Medium"
                         Color="@(isActive ? Color.Primary : isDone ? Color.Success : Color.Default)"
                         Variant="@(isActive ? Variant.Filled : Variant.Outlined)">
                    @if (isDone) { <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" /> }
                    Step @(stepIdx + 1): @stepLabels[stepIdx]
                </MudChip>
            }
        </div>
    </MudPaper>

    @* ── STEP 3: RIASEC Quiz — O*NET Interest Profiler (wizardStep == 0) ── *@
    @if (wizardStep == 0)
    {
        @if (currentPage == 0)
        {
            <MudCard Elevation="3" Class="mb-4">
                <MudCardContent Class="pa-6">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-2">O*NET Interest Profiler</MudText>
                    <MudText Typo="Typo.body1" Class="mb-3">
                        The RIASEC model identifies six interest areas: <strong>Realistic, Investigative, Artistic, Social, Enterprising,</strong> and <strong>Conventional</strong>.
                    </MudText>
                    <MudText Typo="Typo.body1" Class="mb-3">
                        You will see <strong>@questions.Count work activities</strong>. For each one, decide how much you would
                        <strong>like</strong> doing it — not whether you already know how, and not how much education it needs or how much it pays.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        There are no right or wrong answers.
                    </MudText>
                </MudCardContent>
            </MudCard>
        }

        <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:12px;">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Page @(currentPage + 1) of @PageCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@riasecAnswers.Count / @questions.Count answered</MudText>
            </div>
            <MudProgressLinear Value="@(questions.Count == 0 ? 0 : (double)riasecAnswers.Count / questions.Count * 100)" Rounded="true" Size="Size.Medium" Color="Color.Primary" />
        </MudPaper>

        @if (questions.Count > 0)
        {
            <MudCard Elevation="3" Class="mb-4">
                <MudCardHeader Style="background:#007F3B; color:#fff;">
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">How much would you like this activity?</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-6">
                    @foreach (var q in CurrentPageQuestions)
                    {
                        var item = q;
                        var answered = GetRiasecAnswer(item.Id) != null;
                        <MudPaper Class="pa-4 mb-3" Elevation="@(answered ? 2 : 0)"
                                  Style="@($"border-radius:8px; border:2px solid {(answered ? "#007F3B" : "#e0e0e0")}; transition:all 0.2s;")">
                            <MudText Typo="Typo.body1" Class="mb-3" Style="font-weight:600; line-height:1.5;">
                                @QuestionNumber(item). @item.Text
                            </MudText>
                            <MudRadioGroup T="int?" Value="@GetRiasecAnswer(item.Id)"
                                           ValueChanged="@(val => SetRiasecAnswer(item.Id, val))">
                                <div class="d-flex flex-wrap gap-3">
                                    @for (int v = RiasecScale.Min; v <= RiasecScale.Max; v++)
                                    {
                                        var rating = v;
                                        <MudRadio T="int?" Value="@((int?)rating)" Color="Color.Primary" Dense="true">
                                            <MudText Typo="Typo.body2">@RiasecScale.LabelFor(rating)</MudText>
                                        </MudRadio>
                                    }
                                </div>
                            </MudRadioGroup>
                        </MudPaper>
                    }
                </MudCardContent>
            </MudCard>

            <div class="d-flex justify-space-between mb-4">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@(currentPage == 0)"
                           StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="PrevPage">Previous</MudButton>
                @if (currentPage < PageCount - 1)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="NextPage"
                               Disabled="@(!CurrentPageComplete)">Next</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="FinishRiasecStep"
                               Disabled="@(riasecAnswers.Count < questions.Count)">Continue to Career Clarity</MudButton>
                }
            </div>

            <div class="d-flex justify-center flex-wrap gap-2 mb-4">
                @for (int i = 0; i < PageCount; i++)
                {
                    var idx = i;
                    var complete = PageComplete(idx);
                    var isCurrent = idx == currentPage;
                    <MudIconButton Icon="@(complete ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)"
                                   Color="@(isCurrent ? Color.Primary : complete ? Color.Success : Color.Default)"
                                   Size="Size.Small" OnClick="@(() => currentPage = idx)" />
                }
            </div>
        }
    }

    @* ── STEP 4: Career Clarity (wizardStep == 1) ── *@
    else if (wizardStep == 1)
    {
        <MudCard Elevation="3" Class="mb-4">
            <MudCardHeader Style="background:#007F3B; color:#fff;">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Career Clarity Assessment</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-6">
                <MudText Typo="Typo.body1" Class="mb-2">
                    Your dominant RIASEC code is <strong>@computedCode</strong> (@string.Join(", ", computedDimensions)).
                    Now let's assess your career clarity.
                </MudText>

                @* Pick 3 desired roles *@
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">Select your top 3 desired career roles:</MudText>
                @for (int r = 0; r < 3; r++)
                {
                    var roleIdx = r;
                    <MudSelect T="string" Label="@($"Role {roleIdx + 1}")" Variant="Variant.Outlined" Class="mb-3"
                               Value="@GetDesiredRole(roleIdx)" ValueChanged="@(val => SetDesiredRole(roleIdx, val))">
                        @foreach (var role in suggestedRoles)
                        {
                            <MudSelectItem Value="@role">@role</MudSelectItem>
                        }
                    </MudSelect>
                }

                @if (desiredRoles.Count(r => !string.IsNullOrEmpty(r)) >= 3)
                {
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">A. How well does each role match your personality? (1-5)</MudText>
                    @for (int r = 0; r < 3; r++)
                    {
                        var rIdx = r;
                        <div class="d-flex align-center gap-3 mb-2">
                            <MudText Style="min-width:200px;">@desiredRoles[rIdx]</MudText>
                            <MudRating @bind-SelectedValue="fitRatings[rIdx]" MaxValue="5" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@GetFitLabel(fitRatings[rIdx])</MudText>
                        </div>
                    }

                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">B. How excited are you about growing in each role? (1-5)</MudText>
                    @for (int r = 0; r < 3; r++)
                    {
                        var rIdx = r;
                        <div class="d-flex align-center gap-3 mb-2">
                            <MudText Style="min-width:200px;">@desiredRoles[rIdx]</MudText>
                            <MudRating @bind-SelectedValue="excitementRatings[rIdx]" MaxValue="5" Color="Color.Warning" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@GetExcitementLabel(excitementRatings[rIdx])</MudText>
                        </div>
                    }

                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">C. Career Choice Motivation (1-5)</MudText>
                    <div class="mb-3">
                        <MudText Typo="Typo.body1" Class="mb-1">I am genuinely interested in the type of work this career involves:</MudText>
                        <MudRating @bind-SelectedValue="genuineInterest" MaxValue="5" Color="Color.Primary" />
                    </div>
                    <div class="mb-3">
                        <MudText Typo="Typo.body1" Class="mb-1">This career is popular / high-paying / in demand:</MudText>
                        <MudRating @bind-SelectedValue="popularityMotivation" MaxValue="5" Color="Color.Primary" />
                    </div>
                    <div class="mb-3">
                        <MudText Typo="Typo.body1" Class="mb-1">This career is expected by family or others:</MudText>
                        <MudRating @bind-SelectedValue="familyExpectation" MaxValue="5" Color="Color.Primary" />
                    </div>

                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-4 mb-2">D. If salary and job availability were equal, which career would you choose?</MudText>
                    <MudRadioGroup T="int" @bind-Value="salaryNeutralChoice">
                        @for (int r = 0; r < 3; r++)
                        {
                            var rIdx = r;
                            <MudRadio T="int" Value="@rIdx" Color="Color.Primary">@desiredRoles[rIdx]</MudRadio>
                        }
                    </MudRadioGroup>
                }
            </MudCardContent>
        </MudCard>

        <div class="d-flex justify-space-between mb-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => wizardStep = 0)">Back to RIASEC</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="@(() => wizardStep = 2)"
                       Disabled="@(!ClarityStepComplete)">Continue to Academic Performance</MudButton>
        </div>
    }

    @* ── STEP 5: Academic Performance (wizardStep == 2) ── *@
    else if (wizardStep == 2)
    {
        <MudCard Elevation="3" Class="mb-4">
            <MudCardHeader Style="background:#007F3B; color:#fff;">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Academic Performance</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-6">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">GWA Category</MudText>
                <MudSelect T="string" @bind-Value="gwaCategory" Label="Select your GWA range" Variant="Variant.Outlined" Class="mb-4"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Grade">
                    <MudSelectItem Value="@("Outstanding")">Outstanding (1.00 - 1.25)</MudSelectItem>
                    <MudSelectItem Value="@("Very Satisfactory")">Very Satisfactory (1.26 - 2.00)</MudSelectItem>
                    <MudSelectItem Value="@("Satisfactory")">Satisfactory (2.01 - 2.75)</MudSelectItem>
                    <MudSelectItem Value="@("Fair")">Fair (2.76 - 3.00)</MudSelectItem>
                </MudSelect>

                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">Honors</MudText>
                <MudSelect T="string" @bind-Value="honorsCategory" Label="Select your honors level" Variant="Variant.Outlined" Class="mb-4"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.MilitaryTech">
                    <MudSelectItem Value="@("No Honors")">No Honors</MudSelectItem>
                    <MudSelectItem Value="@("Cum Laude")">Cum Laude</MudSelectItem>
                    <MudSelectItem Value="@("Magna Cum Laude")">Magna Cum Laude</MudSelectItem>
                    <MudSelectItem Value="@("Summa Cum Laude")">Summa Cum Laude</MudSelectItem>
                </MudSelect>

                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">Competencies / Skills</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Select all skills that apply to you:</MudText>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var skill in availableSkills)
                    {
                        var s = skill;
                        var isSelected = selectedSkills.Contains(s);
                        <MudChip T="string" Color="@(isSelected ? Color.Primary : Color.Default)"
                                 Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => ToggleSkill(s))" Style="cursor:pointer;">
                            @s
                        </MudChip>
                    }
                </div>
            </MudCardContent>
        </MudCard>

        <div class="d-flex justify-space-between mb-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => wizardStep = 1)">Back to Clarity</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Assessment" OnClick="SubmitFullAssessment"
                       Disabled="@(!RefinementComplete || isSubmitting)">
                @if (isSubmitting)
                {
                    <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Predicting + analyzing with AI…</span>
                }
                else
                {
                    <span>Get My Career Report</span>
                }
            </MudButton>
        </div>
    }

    @if (errorMessage != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }
}

<style>
    .gap-2 { gap: 8px; }
    .gap-3 { gap: 12px; }
</style>

@code {
    // 6-step labels (the chip strip on the wizard pages always shows all six).
    private static readonly string[] stepLabels =
    {
        "Welcome",
        "Consent",
        "RIASEC Quiz",
        "Career Clarity",
        "Academic Performance",
        "Results"
    };

    // ── Prelude State ──
    // preludeStep: 0 = Welcome (auth picker), 1 = Consent, 2 = ready to start the quiz.
    // Authenticated users skip Welcome and land on Consent.
    private int preludeStep = 0;
    private bool consentAccepted = false;

    // ── Step 1: RIASEC (O*NET Interest Profiler) ──
    // Items are shown a page at a time; each answer is a 0-4 rating on RiasecScale.
    private const int QuestionsPerPage = 6;

    private List<RiasecQuestion> questions = new();
    private Dictionary<int, int> riasecAnswers = new();
    private int currentPage = 0;
    private bool isLoadingQuestions = true;

    private string computedCode = "";
    private List<string> computedDimensions = new();
    private List<string> suggestedRoles = new();

    // ── Step 2: Career Clarity ──
    private string[] desiredRoles = new string[3] { "", "", "" };
    private int[] fitRatings = new int[3] { 0, 0, 0 };
    private int[] excitementRatings = new int[3] { 0, 0, 0 };
    private int genuineInterest = 0;
    private int popularityMotivation = 0;
    private int familyExpectation = 0;
    private int salaryNeutralChoice = 0;

    // ── Step 3 / wizardStep == 2: Academic Performance ──
    private int wizardStep = 0;       // 0=Quiz, 1=Clarity, 2=Academics
    private string gwaCategory = "";
    private string honorsCategory = "No Honors";
    private List<string> availableSkills = new();
    private HashSet<string> selectedSkills = new();

    // ── Final ──
    private FullAssessmentResult? finalResult;
    private bool isSubmitting;
    private string? errorMessage;

    // ── Save Result state ──
    private bool isSaving = false;
    private bool saveSucceeded = false;
    private string saveError = "";

    private bool ClarityStepComplete =>
        desiredRoles.All(r => !string.IsNullOrEmpty(r)) &&
        fitRatings.All(r => r >= 1) &&
        excitementRatings.All(r => r >= 1) &&
        genuineInterest >= 1;

    private bool RefinementComplete =>
        !string.IsNullOrEmpty(gwaCategory) && !string.IsNullOrEmpty(honorsCategory) && selectedSkills.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuthChanged;

        // If the user is already signed in, skip the auth picker.
        if (Auth.IsAuthenticated) preludeStep = 1;

        try
        {
            var questionsTask = Http.GetFromJsonAsync<List<RiasecQuestion>>("api/riasec/questions");
            var skillsTask = Http.GetFromJsonAsync<List<string>>("api/riasec/skills");
            await Task.WhenAll(questionsTask, skillsTask);
            questions = questionsTask.Result ?? new();
            availableSkills = skillsTask.Result ?? new();
        }
        catch
        {
            errorMessage = "Failed to load assessment data. Please ensure the server is running.";
        }
        finally
        {
            isLoadingQuestions = false;
        }
    }

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuthChanged;
    }

    private void OnAuthChanged()
    {
        // If sign-in/sign-up succeeds while the Welcome card is open, advance to Consent.
        if (Auth.IsAuthenticated && preludeStep == 0) preludeStep = 1;
        InvokeAsync(StateHasChanged);
    }

    // ── Prelude actions ──
    private async Task OpenLogin()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        await DialogService.ShowAsync<CareerPath.Client.Components.LoginDialog>("Sign In", options);
    }

    private async Task OpenRegister()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        await DialogService.ShowAsync<CareerPath.Client.Components.RegisterDialog>("Student Sign Up", options);
    }

    private async Task OpenRegisterFromResults()
    {
        await OpenRegister();
        // After register, Auth fires the change event and IsStudent flips; Save button becomes enabled.
    }

    private void ContinueAsGuest()
    {
        preludeStep = 1; // straight to Consent
    }

    private void StartQuiz()
    {
        if (!consentAccepted) return;
        preludeStep = 2;
        wizardStep = 0;
        currentPage = 0;
    }

    // ── RIASEC Helpers ──
    private int PageCount => questions.Count == 0
        ? 1
        : (questions.Count + QuestionsPerPage - 1) / QuestionsPerPage;

    private IEnumerable<RiasecQuestion> CurrentPageQuestions =>
        questions.Skip(currentPage * QuestionsPerPage).Take(QuestionsPerPage);

    private int QuestionNumber(RiasecQuestion q) => questions.IndexOf(q) + 1;

    private bool PageComplete(int page) =>
        questions.Skip(page * QuestionsPerPage).Take(QuestionsPerPage)
                 .All(q => riasecAnswers.ContainsKey(q.Id));

    private bool CurrentPageComplete => PageComplete(currentPage);

    private int? GetRiasecAnswer(int qId) => riasecAnswers.TryGetValue(qId, out var v) ? v : null;

    private void SetRiasecAnswer(int qId, int? val)
    {
        if (val is null) riasecAnswers.Remove(qId);
        else riasecAnswers[qId] = val.Value;
    }

    private void NextPage() { if (currentPage < PageCount - 1) currentPage++; }
    private void PrevPage() { if (currentPage > 0) currentPage--; }

    private async Task FinishRiasecStep()
    {
        // Mirror of RiasecService.ComputeRiasecScores — sum each item's 0-4 rating
        // into the RIASEC area that item belongs to. Used only to fetch suggested
        // roles for the next step; the server recomputes the authoritative scores.
        var scores = new Dictionary<string, int> { ["R"]=0,["I"]=0,["A"]=0,["S"]=0,["E"]=0,["C"]=0 };
        foreach (var q in questions)
        {
            if (!riasecAnswers.TryGetValue(q.Id, out var rating)) continue;
            if (scores.ContainsKey(q.Area)) scores[q.Area] += rating;
        }

        var ranked = scores.OrderByDescending(x => x.Value).Take(3).ToList();
        computedCode = string.Join("", ranked.Select(x => x.Key));
        var nameMap = new Dictionary<string, string>
        {
            ["R"]="Realistic",["I"]="Investigative",["A"]="Artistic",
            ["S"]="Social",["E"]="Enterprising",["C"]="Conventional"
        };
        computedDimensions = ranked.Select(x => nameMap[x.Key]).ToList();

        try
        {
            suggestedRoles = await Http.GetFromJsonAsync<List<string>>($"api/riasec/roles/{computedCode}") ?? new();
        }
        catch
        {
            suggestedRoles = new() { "Software Developer", "IT Support", "Network Administrator", "Data Analyst",
                "UI/UX Designer", "IT Project Manager", "Database Administrator", "Systems Administrator",
                "QA Analyst", "Business Analyst" };
        }

        wizardStep = 1;
    }

    // ── Clarity Helpers ──
    private string GetDesiredRole(int idx) => idx < desiredRoles.Length ? desiredRoles[idx] : "";
    private void SetDesiredRole(int idx, string val) { if (idx < desiredRoles.Length) desiredRoles[idx] = val; }

    private static string GetFitLabel(int v) => v switch
    {
        1 => "Very Poor Match", 2 => "Poor Match", 3 => "Fair", 4 => "Good Match", 5 => "Excellent Match", _ => ""
    };
    private static string GetExcitementLabel(int v) => v switch
    {
        1 => "Not Excited", 2 => "Slightly", 3 => "Moderate", 4 => "Very Excited", 5 => "Extremely Excited", _ => ""
    };

    private void ToggleSkill(string skill)
    {
        if (!selectedSkills.Remove(skill))
            selectedSkills.Add(skill);
    }

    // ── Submit: hits /api/riasec/assess with IncludePrediction = true so the
    // single round-trip returns RIASEC + Clarity + MatchedJobs + Prediction +
    // AiAnalysis (the AI prompt is seeded with the prediction). ──
    private async Task SubmitFullAssessment()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var input = new FullAssessmentInput
            {
                RiasecAnswers = riasecAnswers,
                CareerClarity = new CareerClarityInput
                {
                    DesiredRoles = desiredRoles.ToList(),
                    FitRatings = fitRatings.ToList(),
                    ExcitementRatings = excitementRatings.ToList(),
                    GenuineInterest = genuineInterest,
                    PopularityMotivation = popularityMotivation,
                    FamilyExpectation = familyExpectation,
                    SalaryNeutralChoice = salaryNeutralChoice
                },
                GwaCategory = gwaCategory,
                Honors = honorsCategory,
                Skills = selectedSkills.ToList(),
                IncludePrediction = true
            };

            var response = await Http.PostAsJsonAsync("api/riasec/assess", input);
            if (response.IsSuccessStatusCode)
            {
                finalResult = await response.Content.ReadFromJsonAsync<FullAssessmentResult>();
                saveSucceeded = false;
                saveError = "";
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Assessment failed: {body}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task SaveResult()
    {
        if (finalResult == null || finalResult.Prediction == null || !Auth.IsStudent) return;

        isSaving = true;
        saveError = "";
        try
        {
            var req = new SaveResultRequest
            {
                Gwa = gwaCategory,
                Honors = honorsCategory,
                Competencies = string.Join(", ", selectedSkills),
                DominantCode = finalResult.DominantCode,
                ClarityLabel = finalResult.Clarity.ClarityLabel,
                ClarityBucket = finalResult.Clarity.ClarityBucket,
                ClarityTotal = finalResult.Clarity.TotalScore,
                PredictedOutcome = finalResult.Prediction.PredictedOutcome,
                PredictedConfidence = finalResult.Prediction.Confidence,
                AiAnalysis = finalResult.AiAnalysis,
                Notes = ""
            };
            var resp = await Http.PostAsJsonAsync("api/results", req);
            if (resp.IsSuccessStatusCode)
            {
                saveSucceeded = true;
                Snackbar.Add("Result saved to your account.", Severity.Success);
            }
            else
            {
                saveError = $"Save failed: {resp.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    // ── Reset ──
    private void ResetAll()
    {
        wizardStep = 0;
        currentPage = 0;
        riasecAnswers.Clear();
        computedCode = "";
        computedDimensions.Clear();
        suggestedRoles.Clear();
        desiredRoles = new string[3] { "", "", "" };
        fitRatings = new int[3] { 0, 0, 0 };
        excitementRatings = new int[3] { 0, 0, 0 };
        genuineInterest = 0;
        popularityMotivation = 0;
        familyExpectation = 0;
        salaryNeutralChoice = 0;
        gwaCategory = "";
        honorsCategory = "No Honors";
        selectedSkills.Clear();
        finalResult = null;
        errorMessage = null;
        saveSucceeded = false;
        saveError = "";
        // Stay on Consent (don't force the auth picker again).
        preludeStep = Auth.IsAuthenticated ? 1 : 0;
        consentAccepted = false;
    }

    // ── Score Display ──
    private record ScoreDisplay(string Code, string Name, int Score, Color Color);

    private List<ScoreDisplay> GetScoreList()
    {
        if (finalResult == null) return new();
        var s = finalResult.RiasecScores;
        return new()
        {
            new("R", "Realistic", s.Realistic, Color.Success),
            new("I", "Investigative", s.Investigative, Color.Info),
            new("A", "Artistic", s.Artistic, Color.Secondary),
            new("S", "Social", s.Social, Color.Warning),
            new("E", "Enterprising", s.Enterprising, Color.Error),
            new("C", "Conventional", s.Conventional, Color.Dark)
        };
    }

    private static Color GetClarityColor(string label) => label switch
    {
        "Very High Career Clarity" => Color.Success,
        "High Career Clarity" => Color.Primary,
        "Moderate / Needs Guidance" => Color.Warning,
        "Low Career Clarity" => Color.Error,
        _ => Color.Dark
    };
}
