@page "/train-test"
@inject HttpClient Http
@inject CareerPath.Client.Services.AuthService Auth
@implements IDisposable

<PageTitle>Train &amp; Test</PageTitle>

@if (!Auth.IsAdmin)
{
    <MudPaper Class="pa-6 mt-6 mx-auto" Elevation="0" Style="max-width:720px; text-align:center; border:1px solid #e0e0e0; border-radius:12px;">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h5" Class="mt-2 mb-2" Style="font-family:'Source Serif 4',serif;">Researcher Sign-in Required</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            This page contains researcher-facing tools. Please sign in as an administrator via the button in the upper right.
        </MudText>
    </MudPaper>
}
else
{
<MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-2" Style="font-family:'Source Serif 4',serif; border-bottom:3px solid #FFD700; padding-bottom:8px;">
    Train &amp; Test
</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Step 2 of the researcher workflow (after Dataset, before Insights). Shows the most recently
    trained model summary and lets you trigger a fresh training run.
</MudText>

@if (isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (latestRuns == null || latestRuns.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
        <strong>No training runs yet.</strong> Run <code>dotnet run --project src/CareerPath.ML</code> from the
        repository root to generate <code>model.zip</code>, <code>metrics.json</code>, and <code>cv_metrics.json</code>.
        Then refresh this page.
    </MudAlert>
}
else
{
    var newest = latestRuns.OrderByDescending(r => r.TrainedAt).First();

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="3" Class="pa-4" Style="border-radius:12px;">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:1px;">Last Trained</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-family:'Source Serif 4',serif; font-weight:700;">
                    @newest.TrainedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Dataset: @newest.DatasetVersion
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="4">
            <MudPaper Elevation="3" Class="pa-4" Style="border-radius:12px;">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:1px;">RF Mean Accuracy</MudText>
                <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-family:'Source Serif 4',serif; font-weight:700;">
                    @((BestAccuracy() * 100).ToString("F1"))%
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">10-fold CV</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="4">
            <MudPaper Elevation="3" Class="pa-4" Style="border-radius:12px;">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:1px;">Algorithms Trained</MudText>
                <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-family:'Source Serif 4',serif; font-weight:700;">
                    @latestRuns.Select(r => r.Algorithm).Distinct().Count()
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@string.Join(", ", latestRuns.Select(r => r.Algorithm).Distinct())</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudCard Elevation="3" Class="mb-4">
        <MudCardHeader Style="background:#007F3B; color:#fff;">
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Latest Run per (Algorithm × Fold count)</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudSimpleTable Hover="true" Dense="true">
                <thead>
                    <tr>
                        <th>Algorithm</th>
                        <th>Folds</th>
                        <th>Mean Accuracy</th>
                        <th>Mean F1</th>
                        <th>Mean AUC</th>
                        <th>Trained At</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in latestRuns.OrderBy(r => r.Algorithm).ThenBy(r => r.FoldCount))
                    {
                        <tr>
                            <td><strong>@r.Algorithm</strong></td>
                            <td>@r.FoldCount</td>
                            <td>@((r.MeanAccuracy * 100).ToString("F2"))% <small style="color:#888">± @((r.StdAccuracy * 100).ToString("F2"))%</small></td>
                            <td>@((r.MeanF1 * 100).ToString("F2"))%</td>
                            <td>@((r.MeanAuc * 100).ToString("F2"))%</td>
                            <td><small>@r.TrainedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudCardContent>
    </MudCard>
}

<MudCard Elevation="2" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6" Color="Color.Primary">Retrain the model</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Training runs in process: it rebuilds <code>model.zip</code>, <code>metrics.json</code>,
            <code>cv_metrics.json</code>, and the diagnostic confusion matrices. Cross-validation
            takes ~60–90 seconds on a typical box.
        </MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   Disabled="@(isRunningTraining || trainingStatus == "Running")"
                   OnClick="StartTraining">
            @if (isRunningTraining || trainingStatus == "Running")
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Training in progress…</span>
            }
            else
            {
                <span>Initiate Training Run</span>
            }
        </MudButton>

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="ml-2"
                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadStatus">
            Refresh
        </MudButton>

        @if (!string.IsNullOrEmpty(trainingStatus))
        {
            <MudAlert Severity="@StatusSeverity()" Variant="Variant.Outlined" Class="mt-3">
                <strong>Status:</strong> @trainingStatus
                @if (!string.IsNullOrEmpty(lastError))
                {
                    <div class="mt-1"><small>@lastError</small></div>
                }
                @if (startedAt != null)
                {
                    <div class="mt-1"><small>Started: @startedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</small></div>
                }
                @if (completedAt != null)
                {
                    <div class="mt-1"><small>Completed: @completedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</small></div>
                }
            </MudAlert>
        }

        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">
            Equivalent CLI command (for headless retrains):
            <pre style="background:#f5f5f5; padding:8px; border-radius:4px;">dotnet run --project src/CareerPath.ML</pre>
        </MudText>
    </MudCardContent>
</MudCard>
}

@code {
    private bool isLoading = true;
    private List<CareerPath.Shared.TrainingRunDto>? latestRuns;

    private string trainingStatus = "";
    private string lastError = "";
    private DateTime? startedAt;
    private DateTime? completedAt;
    private bool isRunningTraining = false;

    private System.Threading.Timer? statusTimer;

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthStateChanged += OnAuthChanged;
        if (Auth.IsAdmin)
        {
            await LoadStatus();
        }
        else
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuthChanged;
        statusTimer?.Dispose();
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadStatus()
    {
        if (!Auth.IsAdmin) return;
        isLoading = true;
        try
        {
            latestRuns = await Http.GetFromJsonAsync<List<CareerPath.Shared.TrainingRunDto>>("api/training/latest");
        }
        catch
        {
            latestRuns = new();
        }

        try
        {
            var s = await Http.GetFromJsonAsync<TrainingStatusDto>("api/training/run/status");
            if (s != null)
            {
                trainingStatus = s.Status;
                lastError = s.Error ?? "";
                startedAt = s.StartedAt;
                completedAt = s.CompletedAt;
                if (s.Status == "Running")
                {
                    StartStatusPoll();
                }
                else
                {
                    StopStatusPoll();
                }
            }
        }
        catch { /* status endpoint may not exist yet */ }

        isLoading = false;
        StateHasChanged();
    }

    private async Task StartTraining()
    {
        isRunningTraining = true;
        lastError = "";
        try
        {
            var resp = await Http.PostAsync("api/training/run", null);
            if (!resp.IsSuccessStatusCode)
            {
                lastError = $"Failed to start training: {resp.StatusCode}";
                isRunningTraining = false;
                return;
            }
            trainingStatus = "Running";
            startedAt = DateTime.UtcNow;
            completedAt = null;
            StartStatusPoll();
        }
        catch (Exception ex)
        {
            lastError = ex.Message;
        }
        isRunningTraining = false;
    }

    private void StartStatusPoll()
    {
        statusTimer?.Dispose();
        statusTimer = new System.Threading.Timer(async _ => await InvokeAsync(LoadStatus),
            null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void StopStatusPoll()
    {
        statusTimer?.Dispose();
        statusTimer = null;
    }

    private double BestAccuracy()
    {
        if (latestRuns == null || latestRuns.Count == 0) return 0;
        var tenFold = latestRuns
            .Where(r => r.FoldCount == 10)
            .OrderByDescending(r => r.MeanAccuracy)
            .FirstOrDefault();
        return tenFold?.MeanAccuracy ?? latestRuns.Max(r => r.MeanAccuracy);
    }

    private MudBlazor.Severity StatusSeverity()
    {
        return trainingStatus switch
        {
            "Running" => MudBlazor.Severity.Info,
            "Completed" => MudBlazor.Severity.Success,
            "Failed" => MudBlazor.Severity.Error,
            _ => MudBlazor.Severity.Normal
        };
    }

    private class TrainingStatusDto
    {
        public string Status { get; set; } = "Idle";
        public string? Error { get; set; }
        public DateTime? StartedAt { get; set; }
        public DateTime? CompletedAt { get; set; }
    }
}
