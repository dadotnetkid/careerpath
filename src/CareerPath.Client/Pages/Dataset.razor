@page "/dataset"
@inject HttpClient Http
@inject CareerPath.Client.Services.AuthService Auth
@implements IDisposable

<PageTitle>Dataset - Alumni Records</PageTitle>

@if (!Auth.IsAdmin)
{
    <MudPaper Class="pa-6 mt-6 mx-auto" Elevation="0" Style="max-width:720px; text-align:center; border:1px solid #e0e0e0; border-radius:12px;">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h5" Class="mt-2 mb-2" Style="font-family:'Source Serif 4',serif;">Researcher Sign-in Required</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            This page contains researcher-facing analytics. Please sign in as an administrator via the button in the upper right.
        </MudText>
    </MudPaper>
}
else
{
<MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4" Style="font-family:'Source Serif 4',serif; border-bottom:3px solid #FFD700; padding-bottom:8px;">
    Alumni Dataset
</MudText>

@if (summary != null)
{
    <div class="d-flex flex-wrap gap-2 mb-4">
        <MudChip T="string" Color="Color.Primary" Size="Size.Medium">
            Total Records: @summary.TotalRecords
        </MudChip>
        @if (summary.ByCareerOutcome != null && summary.ByCareerOutcome.TryGetValue("ICT-Aligned", out var ictAligned))
        {
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                ICT-Aligned: @ictAligned
            </MudChip>
        }
        @if (summary.ByCareerOutcome != null && summary.ByCareerOutcome.TryGetValue("Non-ICT-Aligned", out var nonIct))
        {
            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Medium">
                Non-ICT-Aligned: @nonIct
            </MudChip>
        }
    </div>
}

<MudCard Elevation="2" Class="mb-4">
    <MudCardContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="selectedHonors" Label="Filter by Honors" Variant="Variant.Outlined"
                           Clearable="true" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("")">All Honors</MudSelectItem>
                    <MudSelectItem Value="@("No Honors")">No Honors</MudSelectItem>
                    <MudSelectItem Value="@("Cum Laude")">Cum Laude</MudSelectItem>
                    <MudSelectItem Value="@("Magna Cum Laude")">Magna Cum Laude</MudSelectItem>
                    <MudSelectItem Value="@("Summa Cum Laude")">Summa Cum Laude</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="searchText" Label="Search" Variant="Variant.Outlined"
                              Placeholder="Search by job title, industry, competencies..." Immediate="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-end">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="LoadData"
                           StartIcon="@Icons.Material.Filled.FilterAlt">Filter</MudButton>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@if (isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}

@if (records != null)
{
    <MudTable Items="@records.Items" Hover="true" Striped="true" Bordered="true" Elevation="2" Dense="true">
        <HeaderContent>
            <MudTh>Year</MudTh>
            <MudTh>GWA</MudTh>
            <MudTh>Honors</MudTh>
            <MudTh>Career Clarity</MudTh>
            <MudTh>RIASEC</MudTh>
            <MudTh>Interest</MudTh>
            <MudTh>Job Title</MudTh>
            <MudTh>Field of Industry</MudTh>
            <MudTh>Career Alignment</MudTh>
            <MudTh>Career Outcome</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.YearGraduated</MudTd>
            <MudTd>@context.Gwa</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetHonorsColor(context.Honors)">
                    @context.Honors
                </MudChip>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@GetClarityColor(context.CareerClarity)">
                    @context.CareerClarity
                </MudChip>
            </MudTd>
            <MudTd>@context.RiasecDominant</MudTd>
            <MudTd><strong>@context.Interest</strong></MudTd>
            <MudTd>@context.JobTitle</MudTd>
            <MudTd>@context.FieldOfIndustry</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetAlignmentColor(context.CareerAlignment)">
                    @context.CareerAlignment
                </MudChip>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.CareerOutcome == "ICT-Aligned" ? Color.Primary : Color.Info)">
                    @context.CareerOutcome
                </MudChip>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <div class="d-flex justify-space-between align-center pa-4">
                <MudText Typo="Typo.body2">
                    Showing @(((currentPage - 1) * pageSize) + 1)-@(Math.Min(currentPage * pageSize, records.Total)) of @records.Total
                </MudText>
                <MudPagination Count="@totalPages" Selected="@currentPage" SelectedChanged="PageChanged"
                               Color="Color.Primary" Variant="Variant.Outlined" />
            </div>
        </PagerContent>
    </MudTable>
}
} @* end auth gate *@

<style>
    .gap-2 { gap: 8px; }
</style>

@code {
    private DatasetSummary? summary;
    private PagedResult<AlumniRecord>? records;
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 50;
    private string selectedHonors = "";
    private string searchText = "";
    private int totalPages => records == null ? 1 : Math.Max(1, (int)Math.Ceiling((double)records.Total / pageSize));
    private bool _authSubscribed = false;

    public void Dispose()
    {
        if (_authSubscribed)
        {
            Auth.AuthStateChanged -= OnAuthChanged;
            _authSubscribed = false;
        }
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        await Auth.RefreshAsync();

        if (!Auth.IsAuthenticated)
        {
            if (!_authSubscribed)
            {
                Auth.AuthStateChanged += OnAuthChanged;
                _authSubscribed = true;
            }
            isLoading = false;
            return;
        }

        summary = await Http.GetFromJsonAsync<DatasetSummary>("api/dataset/summary");
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        currentPage = 1;
        await FetchPage();
    }

    private async Task PageChanged(int page)
    {
        currentPage = page;
        await FetchPage();
    }

    private async Task FetchPage()
    {
        isLoading = true;
        var url = $"api/dataset?page={currentPage}&pageSize={pageSize}";
        if (!string.IsNullOrEmpty(selectedHonors)) url += $"&honors={Uri.EscapeDataString(selectedHonors)}";
        if (!string.IsNullOrEmpty(searchText)) url += $"&search={Uri.EscapeDataString(searchText)}";
        records = await Http.GetFromJsonAsync<PagedResult<AlumniRecord>>(url);
        isLoading = false;
    }

    private static Color GetHonorsColor(string honors) => honors switch
    {
        "Summa Cum Laude" => Color.Warning,
        "Magna Cum Laude" => Color.Secondary,
        "Cum Laude" => Color.Success,
        _ => Color.Default
    };

    private static Color GetClarityColor(string clarity) => clarity switch
    {
        "High" => Color.Success,
        "Medium" => Color.Warning,
        "Low" => Color.Error,
        _ => Color.Default
    };

    private static Color GetAlignmentColor(string alignment) => alignment switch
    {
        "Core ICT" => Color.Success,
        "ICT-Adjacent" => Color.Primary,
        "Non-ICT but Adjacent" => Color.Warning,
        "Non-ICT" => Color.Default,
        _ => Color.Default
    };
}
