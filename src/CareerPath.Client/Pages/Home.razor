@page "/"

<PageTitle>Career Path Recommendation System</PageTitle>

<MudPaper Class="pa-8 mb-6" Style="background: linear-gradient(135deg, #007F3B 0%, #005a2a 100%); border-radius:12px;">
    <div class="d-flex align-center mb-4" style="gap:16px;">
        <img src="images/nvsulogo.png" alt="NVSU Logo" style="height:56px; filter: brightness(0) invert(1); opacity:0.9;" />
        <div>
            <MudText Typo="Typo.h3" Style="color:#fff; font-family:'Source Serif 4',serif; font-weight:700;">
                Career Path Recommendation System
            </MudText>
            <MudText Typo="Typo.subtitle1" Style="color:#FFD701; font-weight:600;" Class="mt-1">
                Nueva Vizcaya State University - Bayombong Campus
            </MudText>
        </div>
    </div>
    <MudText Typo="Typo.body1" Style="color:rgba(255,255,255,0.9); max-width:700px;">
        For graduating students of the College of Information Technology Education (CITE).
        Powered by machine learning trained on 301 CITE alumni records.
    </MudText>
</MudPaper>

<MudGrid Spacing="4" Class="mb-6">
    <MudItem xs="12" md="4">
        <MudCard Elevation="3" Style="height:100%; cursor:pointer;" @onclick='() => Nav.NavigateTo("riasec")'>
            <MudCardContent Class="text-center pa-6">
                <MudIcon Icon="@Icons.Material.Filled.Quiz" Color="Color.Primary" Style="font-size:3rem;" />
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">Career Path Assessment</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    Take the RIASEC interest assessment with career clarity quiz and get AI-powered career guidance.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard Elevation="3" Style="height:100%; cursor:pointer;" @onclick='() => Nav.NavigateTo("dataset")'>
            <MudCardContent Class="text-center pa-6">
                <MudIcon Icon="@Icons.Material.Filled.TableChart" Color="Color.Primary" Style="font-size:3rem;" />
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">Browse Dataset</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    Explore the 301 alumni records from the CHED Graduate Tracer Study used to train the model.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard Elevation="3" Style="height:100%; cursor:pointer;" @onclick='() => Nav.NavigateTo("insights")'>
            <MudCardContent Class="text-center pa-6">
                <MudIcon Icon="@Icons.Material.Filled.Insights" Color="Color.Primary" Style="font-size:3rem;" />
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">Model Insights</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    View model performance metrics, algorithm comparisons, and feature importance analysis.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudCard Elevation="2" Class="mb-6">
    <MudCardHeader>
        <MudText Typo="Typo.h6" Color="Color.Primary">How It Works</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudTimeline TimelinePosition="TimelinePosition.Start">
            <MudTimelineItem Color="Color.Primary" Size="Size.Medium">
                <ItemContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Enter Your Profile</MudText>
                    <MudText Typo="Typo.body2">Provide your course, GWA, competencies, and career interests on the Predict page.</MudText>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem Color="Color.Primary" Size="Size.Medium">
                <ItemContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Machine Learning Prediction</MudText>
                    <MudText Typo="Typo.body2">A Random Forest model trained on 301 CITE alumni records analyzes your profile to predict your likely career alignment.</MudText>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem Color="Color.Primary" Size="Size.Medium">
                <ItemContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">View Results</MudText>
                    <MudText Typo="Typo.body2">See whether your predicted career path is ICT-Aligned or Non-ICT-Aligned, along with confidence scores and similar alumni career outcomes.</MudText>
                </ItemContent>
            </MudTimelineItem>
        </MudTimeline>
    </MudCardContent>
</MudCard>

<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
    <strong>Disclaimer:</strong> Predictions are suggestions based on historical patterns from 301 alumni records, not guarantees.
    Individual career outcomes depend on many factors not captured in this model. Discuss your career plans with your academic adviser or guidance counselor.
</MudAlert>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
}
