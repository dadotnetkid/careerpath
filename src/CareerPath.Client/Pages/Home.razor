@page "/"
@inject CareerPath.Client.Services.AuthService Auth
@implements IDisposable

<PageTitle>Career Path Recommendation System</PageTitle>

<MudPaper Class="pa-8 mb-6" Style="background: linear-gradient(135deg, #007F3B 0%, #005a2a 100%); border-radius:12px;">
    <div class="d-flex align-center mb-4" style="gap:16px;">
        <img src="images/nvsulogo.png" alt="NVSU Logo" style="height:56px; filter: brightness(0) invert(1); opacity:0.9;" />
        <div>
            <MudText Typo="Typo.h3" Style="color:#fff; font-family:'Source Serif 4',serif; font-weight:700;">
                Career Path Recommendation System
            </MudText>
            <MudText Typo="Typo.subtitle1" Style="color:#FFD701; font-weight:600;" Class="mt-1">
                Nueva Vizcaya State University - Bayombong Campus
            </MudText>
        </div>
    </div>
    <MudText Typo="Typo.body1" Style="color:rgba(255,255,255,0.9); max-width:700px;">
        For graduating students of the College of Information Technology Education (CITE).
        Powered by machine learning trained on 301 CITE alumni records.
    </MudText>

    @if (!Auth.IsAuthenticated)
    {
        <div class="d-flex flex-wrap gap-2 mt-4">
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       Style="background:#FFD701; color:#005a2a; font-weight:700;"
                       Href="riasec">
                Start Assessment
            </MudButton>
            <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.85);" Class="ms-1 mt-3">
                CITE students can sign up to save results — guests are welcome to try without an account.
            </MudText>
        </div>
    }
</MudPaper>

<MudGrid Spacing="4" Class="mb-6">
    @* Always visible: the assessment is the primary student-facing flow (and works for guests). *@
    <MudItem xs="12" md="@(Auth.IsAdmin ? 4 : 12)">
        <MudCard Elevation="3" Style="height:100%; cursor:pointer;" @onclick='() => Nav.NavigateTo("riasec")'>
            <MudCardContent Class="text-center pa-6">
                <MudIcon Icon="@Icons.Material.Filled.Quiz" Color="Color.Primary" Style="font-size:3rem;" />
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">Career Path Assessment</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    Take the RIASEC interest assessment with career clarity quiz and get AI-powered career guidance.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>

    @* Admin-only: researcher workflow Dataset -> Train & Test -> Insights. *@
    @if (Auth.IsAdmin)
    {
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Style="height:100%; cursor:pointer;" @onclick='() => Nav.NavigateTo("dataset")'>
                <MudCardContent Class="text-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.TableChart" Color="Color.Primary" Style="font-size:3rem;" />
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">Browse Dataset</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        Explore the 301 alumni records from the CHED Graduate Tracer Study used to train the model.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Style="height:100%; cursor:pointer;" @onclick='() => Nav.NavigateTo("insights")'>
                <MudCardContent Class="text-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.Insights" Color="Color.Primary" Style="font-size:3rem;" />
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">Model Insights</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        View model performance metrics, algorithm comparisons, and feature importance analysis.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@if (Auth.IsAdmin)
{
    <MudPaper Class="pa-4 mb-6" Elevation="1" Style="border-left:6px solid #007F3B; border-radius:6px;">
        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:700;">
            Researcher workflow
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Dataset → Train &amp; Test → Insights. Open the side drawer for the admin links, or jump directly:
        </MudText>
        <div class="d-flex flex-wrap gap-2 mt-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.TableChart" Href="dataset">1 — Dataset</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Science" Href="train-test">2 — Train &amp; Test</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Insights" Href="insights">3 — Insights</MudButton>
        </div>
    </MudPaper>
}

<MudCard Elevation="2" Class="mb-6">
    <MudCardHeader>
        <MudText Typo="Typo.h6" Color="Color.Primary">How It Works</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudTimeline TimelinePosition="TimelinePosition.Start">
            <MudTimelineItem Color="Color.Primary" Size="Size.Medium">
                <ItemContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Take the RIASEC Assessment</MudText>
                    <MudText Typo="Typo.body2">Rate 30 O*NET Interest Profiler work activities, complete the Career Clarity quiz, and enter your GWA, honors, and competencies.</MudText>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem Color="Color.Primary" Size="Size.Medium">
                <ItemContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">ML Predicts Your Alignment</MudText>
                    <MudText Typo="Typo.body2">A Random Forest model trained on 301 CITE alumni records analyzes your profile and predicts whether your likely career outcome is ICT-Aligned or Non-ICT-Aligned.</MudText>
                </ItemContent>
            </MudTimelineItem>
            <MudTimelineItem Color="Color.Primary" Size="Size.Medium">
                <ItemContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">See Similar Alumni Careers</MudText>
                    <MudText Typo="Typo.body2">View confidence scores, both class probabilities, and the actual job titles taken by alumni with profiles similar to yours.</MudText>
                </ItemContent>
            </MudTimelineItem>
        </MudTimeline>
    </MudCardContent>
</MudCard>

<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
    <strong>Disclaimer:</strong> Predictions are suggestions based on historical patterns from 301 alumni records, not guarantees.
    Individual career outcomes depend on many factors not captured in this model. Discuss your career plans with your academic adviser or guidance counselor.
</MudAlert>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuthChanged;
    }

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuthChanged;
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);
}
