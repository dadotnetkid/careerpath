@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService Auth
@inject IDialogService DialogService

<MudLayout>
    <MudAppBar Elevation="3" Dense="false" Style="background: linear-gradient(135deg, #007F3B 0%, #005a2a 100%);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <img src="images/nvsulogo.png" alt="NVSU Logo" style="height:38px; margin-left:8px; margin-right:12px;" />
        <div>
            <MudText Typo="Typo.h6" Style="font-family:'Source Serif 4',serif; font-weight:700; color:#fff; line-height:1.2;">
                Career Path <span style="color:#FFD701;">Recommendation System</span>
            </MudText>
            <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.8); font-size:0.7rem;">
                College of Information Technology Education, NVSU - Bayombong
            </MudText>
        </div>
        <MudSpacer />
        <MudChip T="string" Size="Size.Small" Style="background:rgba(255,255,255,0.15); color:#FFD701; font-weight:600;">
            NVSU CITE
        </MudChip>

        @* Auth control: Sign-In + Sign-Up buttons when anonymous, account menu when signed in. *@
        @if (Auth.IsAuthenticated)
        {
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-2">
                <ActivatorContent>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Inherit"
                               StartIcon="@Icons.Material.Filled.AccountCircle"
                               EndIcon="@Icons.Material.Filled.ArrowDropDown"
                               Style="color:#fff; text-transform:none;">
                        <span style="max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            @Auth.DisplayName
                            @if (!string.IsNullOrEmpty(Auth.Role))
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Style="background:rgba(255,255,255,0.15); color:#FFD701; font-weight:600; margin-left:8px;">
                                    @Auth.Role
                                </MudChip>
                            }
                        </span>
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    @if (Auth.IsStudent)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.BookmarkBorder" Href="my-results">
                            My Saved Results
                        </MudMenuItem>
                    }
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="HandleLogout">
                        Sign Out
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <MudButton StartIcon="@Icons.Material.Filled.PersonAdd"
                       Color="Color.Inherit"
                       Variant="Variant.Text"
                       OnClick="OpenRegister"
                       Style="color:#fff; text-transform:none;"
                       Class="ml-2">
                Sign Up
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Login"
                       Color="Color.Inherit"
                       Variant="Variant.Text"
                       OnClick="OpenLogin"
                       Style="color:#fff; text-transform:none;">
                Sign In
            </MudButton>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="DrawerVariant.Mini"
               OpenMiniOnHover="true">
        <div class="pa-3 text-center" style="border-bottom:1px solid #e0e0e0;">
            <img src="images/nvsulogo.png" alt="NVSU" style="height:30px;" />
        </div>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-4 pb-8" Style="max-width:1280px;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuthChanged;
    }

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuthChanged;
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task OpenLogin()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            NoHeader = true
        };
        await DialogService.ShowAsync<Components.LoginDialog>("Sign In", options);
    }

    private async Task OpenRegister()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            NoHeader = true
        };
        await DialogService.ShowAsync<Components.RegisterDialog>("Student Sign Up", options);
    }

    private async Task HandleLogout()
    {
        await Auth.LogoutAsync();
    }
}
